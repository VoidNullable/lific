{
  // community.lific.dev proxies the community Lific instance on Fly.
  // Deploy with: bunx wrangler deploy (from this directory).
  "$schema": "../../site/node_modules/wrangler/config-schema.json",
  "name": "lific-community-redirect",
  "main": "worker.js",
  "compatibility_date": "2026-07-14",
  "routes": [
    { "pattern": "community.lific.dev", "custom_domain": true }
  ]
}
